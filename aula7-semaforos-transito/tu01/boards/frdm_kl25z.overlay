/ {
    aliases {
        led-ext-vrm = &led_ext_vrm_label;
        led-ext-vd = &led_ext_vd_label;
    };

    leds {
        compatible = "gpio-leds";

        led_ext_vrm_label: led-ext-vrm {
            gpios = <&gpioe 30 GPIO_ACTIVE_LOW>;
        };

        led_ext_vd_label: led-ext-vd {
            gpios = <&gpioe 29 GPIO_ACTIVE_LOW>;
        };
    };
};